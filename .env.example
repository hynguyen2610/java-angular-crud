# Local development only. Replace before sharing an environment.
JWT_SECRET=development-only-secret-change-before-sharing-1234

# Required only by: docker compose -f compose.yaml -f compose.prod.yaml up --build
POSTGRES_DB=product_manager
POSTGRES_USER=product_manager
POSTGRES_PASSWORD=local-postgres-password-change-before-sharing
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=local-admin-password-change-before-sharing

# Required for passkeys in the production-like Compose journey. These must match
# the browser origin and host actually used by the relying party.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:4200

# Local private product-image object storage (never exposed to Angular).
MINIO_ROOT_USER=local-minio-access-key
MINIO_ROOT_PASSWORD=local-minio-secret-change-before-sharing
MINIO_BUCKET=product-images
